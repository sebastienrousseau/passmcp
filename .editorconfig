root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.sh]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[GNUmakefile]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
