# The one codespell configuration. The Docs Lint workflow passes this file
# to the codespell action and pre-commit runs codespell from the repository
# root, where it reads it, so a word allowed here is allowed everywhere.
#
# Skipped: build output, generated sites, hashes, images, HAR captures, and
# test fixtures (some are vendored third-party schemas, spelled as upstream
# spells them). The testdata patterns cover both a directory walk (./x/...)
# and the relative paths pre-commit passes.
[codespell]
skip = ./.git,./build,./dist,./site,./public,./go.sum,*.svg,*.png,*.har,./testdata,testdata/*,*/testdata/*
# te: TokenError receiver; nd: NDJSON buffer; hashi: hasHi bound flag; ded: deduct helper; intoto: in-toto attestation format;
# re-use: the official title of ISO/IEC 27001:2022 A.7.14, quoted in spec/controls.
ignore-words-list = te,nd,hashi,ded,intoto,passs,re-use
quiet-level = 3
