#
# The e2e fixture: one static binary and nothing else. It doubles as the
# stdio server, copied into the passmcp pod by an init container (-install)
# because the passmcp image carries no MCP servers of its own.
FROM scratch
COPY fixture /fixture
USER 65532:65532
ENTRYPOINT ["/fixture"]
